+int AArch64InstrInfo::getJumpTableIndex(const llvm::MachineInstr &MI) const {
+  unsigned Opcode = MI.getOpcode();
+  // $x10, $x11 = JumpTableDest8 $x9, $x8, %XX
+  // BR $x10
+  if (Opcode == AArch64::BR) {
+    Register Reg = MI.getOperand(0).getReg();
+    const MachineInstr *JTD;
+
+    if (Reg.isVirtual()) {
+      const MachineFunction &MF = *MI.getParent()->getParent();
+      const MachineRegisterInfo &MRI = MF.getRegInfo();
+      JTD = MRI.getUniqueVRegDef(Reg);
+    } else {
+      const MachineBasicBlock *MBB = MI.getParent();
+      if (!MBB)
+        return -1;
+      auto I = MI.getReverseIterator();
+      for (; I != MBB->rend(); ++I) {
+        for (const MachineOperand &MO : I->defs()) {
+          if (MO.isReg() && MO.getReg() == Reg && !MO.isImplicit()) {
+            JTD = &*I;
+          }
+        }
+      }
+    }
+
+    if (JTD == nullptr)
+      return -1;
+
+    if (JTD->getOpcode() != AArch64::JumpTableDest8 &&
+        JTD->getOpcode() != AArch64::JumpTableDest16 &&
+        JTD->getOpcode() != AArch64::JumpTableDest32)
+      return -1;
+
+    if (!JTD->getOperand(4).isJTI())
+      return -1;
+
+    return JTD->getOperand(4).getIndex();
+  }
+  return -1;
+}
