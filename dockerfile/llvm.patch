+template <class NodeTy>
+SDValue AArch64TargetLowering::getAddrAbsolute(const GlobalValue* GV, NodeTy *N,
+                                               SelectionDAG &DAG,
+                                               unsigned Flags) const {
+  LLVM_DEBUG(dbgs() << "AArch64TargetLowering::getAddrAbsolute\n");
+  SDLoc DL(N);
+  EVT Ty = getPointerTy(DAG.getDataLayout());
+  ConstantRange CR = GV->getAbsoluteSymbolRange().value();
+  unsigned Width = CR.getUnsignedMax().getActiveBits();
+
+  SDValue Cur;
+  bool First = true;
+
+  auto BuildMov = [&](unsigned MovFlags, unsigned Shift) {
+    SDValue Granule = DAG.getTargetGlobalAddress(
+        GV, DL, Ty, 0, MovFlags | (First ? 0 : AArch64II::MO_NC) | Flags);
+    if (First) {
+      First = false;
+      return SDValue(DAG.getMachineNode(AArch64::MOVZXi, DL, Ty, Granule,
+                                        DAG.getTargetConstant(Shift, DL, MVT::i32)),
+                                        0);
+    } else {
+      return SDValue(DAG.getMachineNode(AArch64::MOVKXi, DL, Ty, Cur, Granule,
+                                        DAG.getTargetConstant(Shift, DL, MVT::i32)),
+                                         0);
+    }
+  };
+
+  if (48 < Width) {
+    Cur = BuildMov(AArch64II::MO_G3, 48);
+  }
+  if (32 < Width) {
+    Cur = BuildMov(AArch64II::MO_G2, 32);
+  }
+  if (16 < Width) {
+    Cur = BuildMov(AArch64II::MO_G1, 16);
+  }
+  return BuildMov(AArch64II::MO_G0, 0);
+}
